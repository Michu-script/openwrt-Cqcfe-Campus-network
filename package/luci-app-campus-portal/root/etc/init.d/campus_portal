#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/sbin/campus_portal_daemon.sh"

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 5 30 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "campus_portal"
}
